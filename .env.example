NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY

# Server only. Copy to .env.local for portal invite creation; never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SIDE_SECRET_KEY
# Set to your real HTTPS domain after deployment (and allow it in Supabase Auth redirect URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional paid AI passport reading. Server-side only; never prefix NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_PASSPORT_MODEL=gpt-4.1-mini
